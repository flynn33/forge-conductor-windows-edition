<Window
 x:Class="ForgeConductorApp.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Forge Conductor"
 Closed="WindowClosed">
 <NavigationView
   x:Name="RootNavigation"
   Background="{StaticResource ForgeAppBackgroundBrush}"
   PaneTitle=""
   PaneDisplayMode="Left"
   IsPaneOpen="True"
   OpenPaneLength="286"
   CompactPaneLength="56"
   CompactModeThresholdWidth="1420"
   ExpandedModeThresholdWidth="1600"
   IsBackButtonVisible="Collapsed"
   IsSettingsVisible="False"
   IsPaneToggleButtonVisible="False"
   IsTitleBarAutoPaddingEnabled="True"
   SelectionChanged="NavigationChanged"
   Loaded="WindowContentLoaded"
   SizeChanged="ConsoleSizeChanged">
  <NavigationView.PaneHeader>
   <StackPanel Margin="10,4,10,14" Spacing="10">
    <StackPanel Orientation="Horizontal" Spacing="9" Margin="38,0,0,0">
     <FontIcon Glyph="&#xE950;" FontSize="18" Foreground="{StaticResource ForgeAccentBrush}" />
     <TextBlock Text="Forge Conductor" FontFamily="Segoe UI Variable Display" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
    </StackPanel>
    <Border Style="{StaticResource ForgeInsetStyle}" Padding="12">
     <Grid ColumnSpacing="10">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Width="34" Height="34" CornerRadius="17" Background="{StaticResource ForgeSuccessSoftBrush}">
       <Ellipse x:Name="NavigationStatusDot" Width="14" Height="14" Fill="{StaticResource ForgeSuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>
      <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
       <TextBlock x:Name="NavigationManagerState" Text="System online" Foreground="{StaticResource ForgeTextPrimaryBrush}" FontWeight="SemiBold" FontSize="12" />
       <TextBlock Text="Production" Foreground="{StaticResource ForgeTextSecondaryBrush}" FontSize="11" />
      </StackPanel>
     </Grid>
    </Border>
   </StackPanel>
  </NavigationView.PaneHeader>
  <NavigationView.MenuItems>
   <NavigationViewItem Content="Rig" Tag="Rig" Icon="Home" IsSelected="True" />
   <NavigationViewItem Content="LM Studio MCP" Tag="LM Studio MCP" Icon="Library" />
   <NavigationViewItem Content="Agents" Tag="Agents" Icon="People" />
   <NavigationViewItem Content="Tools" Tag="Tools" Icon="Repair" />
   <NavigationViewItem Content="Feed" Tag="Feed" Icon="Document" />
   <NavigationViewItem Content="Projects" Tag="Projects" Icon="Folder" />
   <NavigationViewItem Content="Autonomy" Tag="Autonomy" Icon="Play" />
   <NavigationViewItem Content="Continuity" Tag="Continuity" Icon="Refresh" />
   <NavigationViewItem Content="Runtimes" Tag="Runtimes" Icon="World" />
   <NavigationViewItem Content="Provider" Tag="Provider" Icon="Link" />
   <NavigationViewItem Content="Events &amp; Evidence" Tag="Events &amp; Evidence" Icon="Document" />
   <NavigationViewItem Content="Diagnostics" Tag="Diagnostics" Icon="Repair" />
   <NavigationViewItem Content="Manager" Tag="Manager" Icon="Admin" />
   <NavigationViewItem Content="Settings" Tag="Settings" Icon="Setting" />
  </NavigationView.MenuItems>
  <NavigationView.PaneFooter>
   <Border Margin="10,8,10,16" Style="{StaticResource ForgeInsetStyle}" Padding="12">
    <Grid ColumnSpacing="10">
     <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Border Width="34" Height="34" CornerRadius="9" Background="{StaticResource ForgeAccentSoftBrush}">
      <FontIcon Glyph="&#xE7F4;" FontSize="16" Foreground="{StaticResource ForgeAccentBrush}" />
     </Border>
     <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
      <TextBlock x:Name="FooterMachineName" Text="Windows workstation" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis" />
      <TextBlock Text="Windows 11 · x64" Foreground="{StaticResource ForgeTextSecondaryBrush}" FontSize="11" />
     </StackPanel>
    </Grid>
   </Border>
  </NavigationView.PaneFooter>
  <ScrollViewer x:Name="MainScrollViewer" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" VerticalScrollBarVisibility="Auto">
   <StackPanel x:Name="PageContent" Padding="26,22,26,36" Spacing="14" HorizontalAlignment="Stretch">
    <Grid x:Name="HeaderGrid" ColumnSpacing="20">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="HeaderProfileColumn" Width="Auto"/></Grid.ColumnDefinitions>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel Spacing="4">
      <TextBlock x:Name="PageTitle" Text="Rig" FontFamily="Segoe UI Variable Display" FontSize="30" FontWeight="SemiBold" Foreground="{StaticResource ForgeTextPrimaryBrush}" />
      <TextBlock x:Name="PageDescription" Text="Manager, runtime, and provider health." TextWrapping="Wrap" Foreground="{StaticResource ForgeTextSecondaryBrush}" FontSize="14" />
     </StackPanel>
     <Border x:Name="ProfileCard" Grid.Column="1" Background="Transparent" Padding="0" MinWidth="610" VerticalAlignment="Center">
      <Grid ColumnSpacing="16">
       <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="1"/><ColumnDefinition Width="250"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions>
       <StackPanel Spacing="4">
        <TextBlock Text="Environment" Style="{StaticResource ForgeCaptionStyle}" />
        <ComboBox HorizontalAlignment="Stretch" SelectedIndex="0" MinHeight="34">
         <ComboBoxItem Content="Production" />
        </ComboBox>
       </StackPanel>
       <Border Grid.Column="1" Width="1" Height="44" Background="{StaticResource ForgeDividerBrush}" VerticalAlignment="Center" />
       <StackPanel Grid.Column="2" Spacing="4" VerticalAlignment="Center">
        <TextBlock Text="Data path" Style="{StaticResource ForgeCaptionStyle}" />
        <TextBlock Text="%LOCALAPPDATA%\Forge Conductor" Foreground="{StaticResource ForgeTextPrimaryBrush}" FontSize="12" TextTrimming="CharacterEllipsis" />
        <TextBlock x:Name="ProfileState" Text="Deployment profile unavailable" Visibility="Collapsed" />
       </StackPanel>
       <Button Grid.Column="3" Width="42" Height="42" Padding="0" Click="RefreshClicked" AutomationProperties.Name="Refresh dashboard">
        <FontIcon Glyph="&#xE72C;" FontSize="17" />
       </Button>
       <StackPanel Grid.Column="4" Spacing="4" VerticalAlignment="Center">
        <TextBlock Text="Last updated" Style="{StaticResource ForgeCaptionStyle}" />
        <TextBlock x:Name="LastUpdatedText" Text="Waiting for data" Foreground="{StaticResource ForgeTextSecondaryBrush}" FontSize="12" />
       </StackPanel>
      </Grid>
     </Border>
    </Grid>

     <StackPanel x:Name="RigPanel" Spacing="10">
      <Border Style="{StaticResource ForgeHeroCardStyle}" MinHeight="118">
       <Grid ColumnSpacing="18">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="1"/><ColumnDefinition Width="250"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Border Width="64" Height="64" CornerRadius="14" Background="{StaticResource ForgeAccentSoftBrush}" VerticalAlignment="Center">
         <FontIcon Glyph="&#xE7F4;" FontSize="30" Foreground="#FF5AC4FF" />
        </Border>
        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
         <TextBlock x:Name="SystemStrip" Text="Waiting for system identity" TextWrapping="Wrap" FontFamily="Segoe UI Variable Display" FontSize="23" FontWeight="SemiBold" AutomationProperties.Name="System identity" />
         <TextBlock x:Name="HeroOsText" Text="Windows workstation" Foreground="{StaticResource ForgeTextPrimaryBrush}" FontSize="13" AutomationProperties.Name="Host operating system"/>
         <TextBlock x:Name="SamplingStrip" Text="Waiting for sampling cadence" TextWrapping="Wrap" Foreground="{StaticResource ForgeTextSecondaryBrush}" FontSize="12" MaxLines="2" AutomationProperties.Name="Telemetry sampling cadence" />
        </StackPanel>
        <Border Grid.Column="2" Width="1" Height="64" Background="{StaticResource ForgeDividerBrush}" VerticalAlignment="Center" />
        <StackPanel Grid.Column="3" Spacing="5" VerticalAlignment="Center">
         <StackPanel Orientation="Horizontal" Spacing="8">
          <Ellipse x:Name="HeroManagerDot" Width="11" Height="11" Fill="{StaticResource ForgeSuccessBrush}" VerticalAlignment="Center" />
          <TextBlock x:Name="HeroManagerLabel" Text="Service status pending" FontWeight="SemiBold" FontSize="15" />
         </StackPanel>
         <TextBlock x:Name="ManagerHealth" Text="Waiting for a sample" TextWrapping="Wrap" Foreground="{StaticResource ForgeTextSecondaryBrush}" FontSize="12" MaxLines="2" AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
        <Button Grid.Column="4" Content="Open in Manager" Click="OpenManagerClicked" MinWidth="170" VerticalAlignment="Center" />
       </Grid>
      </Border>

      <Grid x:Name="TelemetryGrid" ColumnSpacing="12" RowSpacing="12">
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition x:Name="MetricColumn2" Width="*"/><ColumnDefinition x:Name="MetricColumn3" Width="*"/></Grid.ColumnDefinitions>
       <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <Border x:Name="CpuMetricCard" Style="{StaticResource ForgeCardStyle}" MinHeight="176">
        <Grid RowSpacing="7"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
         <StackPanel Orientation="Horizontal" Spacing="9"><FontIcon Glyph="&#xE950;" FontSize="17" Foreground="{StaticResource ForgeAccentBrush}"/><TextBlock Text="CPU" Style="{StaticResource ForgeSectionTitleStyle}"/></StackPanel>
         <Grid Grid.Row="1"><TextBlock x:Name="CpuValue" Text="Unavailable" Style="{StaticResource ForgeMetricValueStyle}" VerticalAlignment="Center" AutomationProperties.Name="CPU current value"/><Canvas x:Name="MiniCpuCanvas" Width="112" Height="42" HorizontalAlignment="Right" VerticalAlignment="Center" AutomationProperties.Name="CPU local measured trend sparkline"><Line X1="0" Y1="32" X2="112" Y2="32" Stroke="{StaticResource ForgeChartGridBrush}"/><Polyline x:Name="MiniCpuLine" Stroke="#FF49BEFF" StrokeThickness="2"/></Canvas></Grid>
         <Grid Grid.Row="2" Height="8"><Border x:Name="CpuGaugeTrack" Background="#FF36465B" CornerRadius="4" SizeChanged="TelemetryGaugeSizeChanged"/><Border x:Name="CpuGaugeFill" Width="0" HorizontalAlignment="Left" Background="#FF39B8FF" CornerRadius="4"/><ProgressBar x:Name="CpuGauge" Visibility="Collapsed" Minimum="0" Maximum="100" IsIndeterminate="True" AutomationProperties.Name="CPU utilization"/></Grid>
         <TextBlock x:Name="CpuState" Grid.Row="3" Text="Waiting for a sample" Style="{StaticResource ForgeCaptionStyle}" MaxLines="2"/>
        </Grid>
       </Border>
       <Border x:Name="RamMetricCard" Grid.Column="1" Style="{StaticResource ForgeCardStyle}" MinHeight="176">
        <Grid RowSpacing="7"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
         <StackPanel Orientation="Horizontal" Spacing="9"><FontIcon Glyph="&#xE7F1;" FontSize="17" Foreground="#FF7868FF"/><TextBlock Text="RAM" Style="{StaticResource ForgeSectionTitleStyle}"/></StackPanel>
         <Grid Grid.Row="1"><TextBlock x:Name="RamValue" Text="Unavailable" Style="{StaticResource ForgeMetricValueStyle}" VerticalAlignment="Center" AutomationProperties.Name="RAM current value"/><Canvas x:Name="MiniRamCanvas" Width="112" Height="42" HorizontalAlignment="Right" VerticalAlignment="Center" AutomationProperties.Name="RAM local measured trend sparkline"><Line X1="0" Y1="32" X2="112" Y2="32" Stroke="{StaticResource ForgeChartGridBrush}"/><Polyline x:Name="MiniRamLine" Stroke="#FF7868FF" StrokeThickness="2"/></Canvas></Grid>
         <Grid Grid.Row="2" Height="8"><Border x:Name="RamGaugeTrack" Background="#FF36465B" CornerRadius="4" SizeChanged="TelemetryGaugeSizeChanged"/><Border x:Name="RamGaugeFill" Width="0" HorizontalAlignment="Left" Background="#FF7868FF" CornerRadius="4"/><ProgressBar x:Name="RamGauge" Visibility="Collapsed" Minimum="0" Maximum="100" IsIndeterminate="True" AutomationProperties.Name="RAM utilization"/></Grid>
         <TextBlock x:Name="RamState" Grid.Row="3" Text="Waiting for a sample" Style="{StaticResource ForgeCaptionStyle}" MaxLines="2"/>
        </Grid>
       </Border>
       <Border x:Name="GpuMetricCard" Grid.Column="2" Style="{StaticResource ForgeCardStyle}" MinHeight="176">
        <Grid RowSpacing="7"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
         <StackPanel Orientation="Horizontal" Spacing="9"><FontIcon Glyph="&#xE7F4;" FontSize="17" Foreground="#FF38D6E9"/><TextBlock Text="GPU" Style="{StaticResource ForgeSectionTitleStyle}"/></StackPanel>
         <Grid Grid.Row="1"><TextBlock x:Name="GpuValue" Text="Unavailable" Style="{StaticResource ForgeMetricValueStyle}" VerticalAlignment="Center" AutomationProperties.Name="GPU current value"/><Canvas x:Name="MiniGpuCanvas" Width="112" Height="42" HorizontalAlignment="Right" VerticalAlignment="Center" AutomationProperties.Name="GPU local measured trend sparkline"><Line X1="0" Y1="32" X2="112" Y2="32" Stroke="{StaticResource ForgeChartGridBrush}"/><Polyline x:Name="MiniGpuLine" Stroke="#FF38D6E9" StrokeThickness="2"/></Canvas></Grid>
         <Grid Grid.Row="2" Height="8"><Border x:Name="GpuGaugeTrack" Background="#FF36465B" CornerRadius="4" SizeChanged="TelemetryGaugeSizeChanged"/><Border x:Name="GpuGaugeFill" Width="0" HorizontalAlignment="Left" Background="#FF37D5E9" CornerRadius="4"/><ProgressBar x:Name="GpuGauge" Visibility="Collapsed" Minimum="0" Maximum="100" IsIndeterminate="True" AutomationProperties.Name="GPU utilization"/></Grid>
         <TextBlock x:Name="GpuState" Grid.Row="3" Text="Waiting for a sample" Style="{StaticResource ForgeCaptionStyle}" MaxLines="2"/>
        </Grid>
       </Border>
       <Border x:Name="ContextMetricCard" Grid.Column="3" Style="{StaticResource ForgeCardStyle}" MinHeight="176">
        <Grid RowSpacing="7"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
         <StackPanel Orientation="Horizontal" Spacing="9"><FontIcon Glyph="&#xE8F1;" FontSize="17" Foreground="#FF448DFF"/><TextBlock Text="Retained context" Style="{StaticResource ForgeSectionTitleStyle}"/></StackPanel>
         <TextBlock x:Name="ContextValue" Grid.Row="1" Text="No selected run" Style="{StaticResource ForgeMetricValueStyle}" FontSize="25" TextWrapping="Wrap" VerticalAlignment="Center" MaxLines="2" AutomationProperties.Name="Retained context value"/>
         <Grid Grid.Row="2" Height="8"><Border x:Name="ContextGaugeTrack" Background="#FF36465B" CornerRadius="4" SizeChanged="TelemetryGaugeSizeChanged"/><Border x:Name="ContextGaugeFill" Width="0" HorizontalAlignment="Left" Background="#FF448DFF" CornerRadius="4"/><ProgressBar x:Name="ContextGauge" Visibility="Collapsed" Minimum="0" Maximum="100" IsIndeterminate="True" AutomationProperties.Name="Retained context capacity"/></Grid>
         <TextBlock x:Name="ContextState" Grid.Row="3" Text="Waiting for a run sample" Style="{StaticResource ForgeCaptionStyle}" MaxLines="2"/>
        </Grid>
       </Border>
      </Grid>

      <Grid ColumnSpacing="12">
       <Grid.ColumnDefinitions><ColumnDefinition Width="5*"/><ColumnDefinition Width="7*"/></Grid.ColumnDefinitions>
       <Border Style="{StaticResource ForgeCardStyle}" MinHeight="250">
        <StackPanel Spacing="7">
         <Grid><StackPanel Orientation="Horizontal" Spacing="9"><FontIcon Glyph="&#xE713;" FontSize="17" Foreground="{StaticResource ForgeAccentBrush}"/><TextBlock Text="Runtime configuration" Style="{StaticResource ForgeSectionTitleStyle}"/></StackPanel><Button HorizontalAlignment="Right" Content="Edit configuration" Click="OpenSettingsClicked"/></Grid>
         <Border Style="{StaticResource ForgeInsetStyle}" Padding="12,9"><Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="90"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><FontIcon Glyph="&#xE77B;" Foreground="{StaticResource ForgeTextSecondaryBrush}"/><TextBlock Grid.Column="1" Text="Manager"/><Ellipse x:Name="WorkflowDot" Grid.Column="2" Width="8" Height="8" Fill="{StaticResource ForgeSuccessBrush}" VerticalAlignment="Center"/><TextBlock x:Name="WorkflowStatus" Grid.Column="3" Margin="8,0,0,0" Text="Waiting for Manager workflow inventory" TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite"/><FontIcon Grid.Column="4" Glyph="&#xE76C;" Foreground="{StaticResource ForgeTextTertiaryBrush}"/></Grid></Border>
         <Border Style="{StaticResource ForgeInsetStyle}" Padding="12,9"><Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="90"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><FontIcon Glyph="&#xE71B;" Foreground="{StaticResource ForgeTextSecondaryBrush}"/><TextBlock Grid.Column="1" Text="Provider"/><Ellipse x:Name="ProviderDot" Grid.Column="2" Width="8" Height="8" Fill="{StaticResource ForgeSuccessBrush}" VerticalAlignment="Center"/><TextBlock x:Name="ProviderHealth" Grid.Column="3" Margin="8,0,0,0" Text="Waiting for a sample" TextTrimming="CharacterEllipsis"/><FontIcon Grid.Column="4" Glyph="&#xE76C;" Foreground="{StaticResource ForgeTextTertiaryBrush}"/></Grid></Border>
         <Border Style="{StaticResource ForgeInsetStyle}" Padding="12,9"><Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="90"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><FontIcon Glyph="&#xE8F1;" Foreground="{StaticResource ForgeTextSecondaryBrush}"/><TextBlock Grid.Column="1" Text="Continuity"/><Ellipse x:Name="ContinuityDot" Grid.Column="2" Width="8" Height="8" Fill="{StaticResource ForgeSuccessBrush}" VerticalAlignment="Center"/><TextBlock x:Name="ContinuityHealth" Grid.Column="3" Margin="8,0,0,0" Text="Waiting for a sample" TextTrimming="CharacterEllipsis"/><FontIcon Grid.Column="4" Glyph="&#xE76C;" Foreground="{StaticResource ForgeTextTertiaryBrush}"/></Grid></Border>
         <Border Style="{StaticResource ForgeInsetStyle}" Padding="12,9"><Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="90"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><FontIcon Glyph="&#xE8B7;" Foreground="{StaticResource ForgeTextSecondaryBrush}"/><TextBlock Grid.Column="1" Text="Store"/><Ellipse x:Name="StoreDot" Grid.Column="2" Width="8" Height="8" Fill="{StaticResource ForgeSuccessBrush}" VerticalAlignment="Center"/><TextBlock x:Name="StoreHealth" Grid.Column="3" Margin="8,0,0,0" Text="Waiting for a sample" TextTrimming="CharacterEllipsis"/><FontIcon Grid.Column="4" Glyph="&#xE76C;" Foreground="{StaticResource ForgeTextTertiaryBrush}"/></Grid></Border>
        </StackPanel>
       </Border>
       <Border Grid.Column="1" Style="{StaticResource ForgeCardStyle}" MinHeight="250">
        <Grid RowSpacing="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
         <Grid><StackPanel Orientation="Horizontal" Spacing="9"><FontIcon Glyph="&#xE9D9;" FontSize="17" Foreground="{StaticResource ForgeAccentBrush}"/><TextBlock Text="Resource utilization" Style="{StaticResource ForgeSectionTitleStyle}"/></StackPanel><Border HorizontalAlignment="Right" Background="{StaticResource ForgeSurfaceSubtleBrush}" CornerRadius="7" Padding="10,5"><TextBlock Text="Last 60 seconds" Style="{StaticResource ForgeCaptionStyle}"/></Border></Grid>
         <TextBlock x:Name="HistoryEquivalentText" Grid.Row="1" Text="No history samples" Style="{StaticResource ForgeCaptionStyle}" TextTrimming="CharacterEllipsis" AutomationProperties.Name="Resource history values"/>
         <Grid Grid.Row="2" Height="144" ColumnSpacing="7"><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Spacing="15" VerticalAlignment="Center"><TextBlock Text="100%" Style="{StaticResource ForgeCaptionStyle}"/><TextBlock Text="75%" Style="{StaticResource ForgeCaptionStyle}"/><TextBlock Text="50%" Style="{StaticResource ForgeCaptionStyle}"/><TextBlock Text="25%" Style="{StaticResource ForgeCaptionStyle}"/><TextBlock Text="0%" Style="{StaticResource ForgeCaptionStyle}"/></StackPanel><Grid Grid.Column="1" Background="{StaticResource ForgeSurfaceSubtleBrush}"><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions><Border BorderBrush="{StaticResource ForgeChartGridBrush}" BorderThickness="0,0,0,1"/><Border Grid.Row="1" BorderBrush="{StaticResource ForgeChartGridBrush}" BorderThickness="0,0,0,1"/><Border Grid.Row="2" BorderBrush="{StaticResource ForgeChartGridBrush}" BorderThickness="0,0,0,1"/><Canvas x:Name="HistoryCanvas" Grid.RowSpan="4" MinWidth="320" Background="Transparent" AutomationProperties.Name="CPU RAM and GPU history chart" SizeChanged="TelemetryChartSizeChanged"><Polyline x:Name="CpuHistoryLine" Stroke="#FF39B8FF" StrokeThickness="3"/><Polyline x:Name="RamHistoryLine" Stroke="#FF7868FF" StrokeThickness="3"/><Polyline x:Name="GpuHistoryLine" Stroke="#FF37D5E9" StrokeThickness="2"/></Canvas></Grid></Grid>
         <Grid Grid.Row="3" ColumnSpacing="18"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" Spacing="6"><Ellipse Width="8" Height="8" Fill="#FF39B8FF"/><TextBlock x:Name="HistoryCpuLegend" Text="CPU" Style="{StaticResource ForgeCaptionStyle}"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"><Ellipse Width="8" Height="8" Fill="#FF7868FF"/><TextBlock x:Name="HistoryRamLegend" Text="RAM" Style="{StaticResource ForgeCaptionStyle}"/></StackPanel><StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6"><Ellipse Width="8" Height="8" Fill="#FF37D5E9"/><TextBlock x:Name="HistoryGpuLegend" Text="GPU" Style="{StaticResource ForgeCaptionStyle}"/></StackPanel><TextBlock Grid.Column="3" Text="−60s          −30s          now" Style="{StaticResource ForgeCaptionStyle}" HorizontalAlignment="Right"/></Grid>
        </Grid>
       </Border>
      </Grid>

      <Grid ColumnSpacing="12">
       <Grid.ColumnDefinitions><ColumnDefinition Width="7*"/><ColumnDefinition Width="5*"/></Grid.ColumnDefinitions>
       <Border Style="{StaticResource ForgeCardStyle}" MinHeight="150"><StackPanel Spacing="8"><Grid><StackPanel Orientation="Horizontal" Spacing="9"><FontIcon Glyph="&#xE823;" FontSize="16" Foreground="{StaticResource ForgeAccentBrush}"/><TextBlock Text="Recent activity" Style="{StaticResource ForgeSectionTitleStyle}"/></StackPanel><Button HorizontalAlignment="Right" Content="View all" Click="OpenFeedClicked"/></Grid><ScrollViewer MaxHeight="135" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="ActivityTimeline" Spacing="4" AutomationProperties.Name="Recent Manager activity timeline"/></ScrollViewer></StackPanel></Border>
       <Border Grid.Column="1" Style="{StaticResource ForgeCardStyle}" MinHeight="150"><Grid RowSpacing="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel Orientation="Horizontal" Spacing="9"><FontIcon Glyph="&#xE768;" FontSize="17" Foreground="{StaticResource ForgeAccentBrush}"/><TextBlock Text="Actions" Style="{StaticResource ForgeSectionTitleStyle}"/></StackPanel><Grid Grid.Row="1" ColumnSpacing="8" RowSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Button Content="Open in Manager" Click="OpenManagerClicked" Style="{StaticResource ForgeAccentButtonStyle}" HorizontalAlignment="Stretch"/><Button Grid.Column="1" Content="Start a run" Click="OpenAutonomyClicked" HorizontalAlignment="Stretch"/><Button Grid.Row="1" Content="Refresh" Click="RefreshClicked" HorizontalAlignment="Stretch"/><Button Grid.Row="1" Grid.Column="1" Content="View logs" Click="OpenFeedClicked" HorizontalAlignment="Stretch"/></Grid><TextBlock x:Name="ManagerState" Visibility="Collapsed" Text="Forge Conductor is establishing the per-user Manager automatically." AutomationProperties.LiveSetting="Polite"/></Grid></Border>
      </Grid>

      <TextBlock Text="System detail" Style="{StaticResource ForgeSectionTitleStyle}" Margin="2,8,0,0"/>
      <Grid ColumnSpacing="12" RowSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <Border Style="{StaticResource ForgeCardStyle}"><StackPanel Spacing="8"><TextBlock Text="Logical processors" Style="{StaticResource ForgeSectionTitleStyle}"/><TextBlock Text="Per-logical utilization and native frequency" Style="{StaticResource ForgeCaptionStyle}"/><ScrollViewer MaxHeight="310" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="CpuCoreRows" Spacing="8" AutomationProperties.Name="Logical processor telemetry"/></ScrollViewer></StackPanel></Border>
       <Border Grid.Column="1" Style="{StaticResource ForgeCardStyle}"><StackPanel Spacing="8"><TextBlock Text="GPU adapters and engines" Style="{StaticResource ForgeSectionTitleStyle}"/><ScrollViewer MaxHeight="310" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="GpuAdapterRows" Spacing="8" AutomationProperties.Name="GPU adapter and engine telemetry"/></ScrollViewer></StackPanel></Border>
       <Border Grid.Row="1" Style="{StaticResource ForgeCardStyle}"><StackPanel Spacing="8"><TextBlock Text="Disk activity" Style="{StaticResource ForgeSectionTitleStyle}"/><TextBlock x:Name="DiskState" Text="Waiting for disk counters" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/><StackPanel x:Name="VolumeRows" Spacing="4" AutomationProperties.Name="Mounted volume capacity"/></StackPanel></Border>
       <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource ForgeCardStyle}"><StackPanel Spacing="8"><TextBlock Text="Relevant native processes" Style="{StaticResource ForgeSectionTitleStyle}"/><StackPanel x:Name="ProcessRows" Spacing="4" AutomationProperties.Name="Forge and model server processes"/></StackPanel></Border>
      </Grid>
      <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <Border Style="{StaticResource ForgeCardStyle}"><StackPanel Spacing="6"><TextBlock Text="Disk throughput" Style="{StaticResource ForgeSectionTitleStyle}"/><TextBlock x:Name="DiskHistoryEquivalentText" Text="No disk throughput history" Style="{StaticResource ForgeCaptionStyle}" AutomationProperties.Name="Disk throughput history values"/><Canvas x:Name="DiskHistoryCanvas" Height="72" MinWidth="180" Background="{StaticResource ForgeSurfaceSubtleBrush}" AutomationProperties.Name="Disk throughput history chart" SizeChanged="TelemetryChartSizeChanged"><Polyline x:Name="DiskHistoryLine" Stroke="{StaticResource ForgeSuccessBrush}" StrokeThickness="3"/></Canvas></StackPanel></Border>
       <Border Grid.Column="1" Style="{StaticResource ForgeCardStyle}"><StackPanel Spacing="6"><TextBlock Text="Tool and provider latency" Style="{StaticResource ForgeSectionTitleStyle}"/><TextBlock x:Name="LatencyEquivalentText" Text="No latency observations" Style="{StaticResource ForgeCaptionStyle}" AutomationProperties.Name="Activity latency values"/><Canvas x:Name="LatencyCanvas" Height="72" MinWidth="180" Background="{StaticResource ForgeSurfaceSubtleBrush}" AutomationProperties.Name="Recent activity latency chart" SizeChanged="TelemetryChartSizeChanged"><Polyline x:Name="LatencyHistoryLine" Stroke="{StaticResource ForgeWarningBrush}" StrokeThickness="3"/></Canvas></StackPanel></Border>
