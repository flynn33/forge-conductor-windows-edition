<Window x:Class="ForgeConductorApp.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Forge Conductor" Closed="WindowClosed">
 <NavigationView x:Name="RootNavigation" IsBackButtonVisible="Collapsed"
   IsSettingsVisible="False" PaneDisplayMode="Left" SelectionChanged="NavigationChanged" Loaded="WindowContentLoaded">
  <NavigationView.MenuItems>
   <NavigationViewItem Content="Rig" Tag="Rig" Icon="Home" IsSelected="True" />
   <NavigationViewItem Content="LM Studio MCP" Tag="LM Studio MCP" />
   <NavigationViewItem Content="Agents" Tag="Agents" />
   <NavigationViewItem Content="Tools" Tag="Tools" />
   <NavigationViewItem Content="Feed" Tag="Feed" />
   <NavigationViewItem Content="Projects" Tag="Projects" />
   <NavigationViewItem Content="Autonomy" Tag="Autonomy" />
   <NavigationViewItem Content="Continuity" Tag="Continuity" />
   <NavigationViewItem Content="Runtimes" Tag="Runtimes" />
   <NavigationViewItem Content="Provider" Tag="Provider" />
   <NavigationViewItem Content="Events &amp; Evidence" Tag="Events &amp; Evidence" />
   <NavigationViewItem Content="Diagnostics" Tag="Diagnostics" />
   <NavigationViewItem Content="Manager" Tag="Manager" />
   <NavigationViewItem Content="Settings" Tag="Settings" />
  </NavigationView.MenuItems>
  <ScrollViewer>
   <StackPanel Padding="32" Spacing="14" MaxWidth="920" HorizontalAlignment="Left">
    <TextBlock x:Name="PageTitle" Text="Rig" Style="{ThemeResource TitleTextBlockStyle}" />
    <TextBlock x:Name="PageDescription" Text="Manager, runtime, and provider health." TextWrapping="Wrap" Opacity="0.72" />

    <StackPanel x:Name="RigPanel" Spacing="14">
     <Grid ColumnSpacing="12" RowSpacing="12">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Border Padding="16" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
       <StackPanel Spacing="4">
        <TextBlock Text="Manager" Style="{ThemeResource CaptionTextBlockStyle}" />
        <TextBlock x:Name="ManagerHealth" Text="Waiting for a sample" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
       </StackPanel>
      </Border>
      <Border Grid.Column="1" Padding="16" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
       <StackPanel Spacing="4">
        <TextBlock Text="Provider" Style="{ThemeResource CaptionTextBlockStyle}" />
        <TextBlock x:Name="ProviderHealth" Text="Waiting for a sample" TextWrapping="Wrap" />
       </StackPanel>
      </Border>
      <Border Grid.Row="1" Padding="16" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
       <StackPanel Spacing="4">
        <TextBlock Text="Continuity" Style="{ThemeResource CaptionTextBlockStyle}" />
        <TextBlock x:Name="ContinuityHealth" Text="Waiting for a sample" TextWrapping="Wrap" />
       </StackPanel>
      </Border>
      <Border Grid.Row="1" Grid.Column="1" Padding="16" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
       <StackPanel Spacing="4">
        <TextBlock Text="Store" Style="{ThemeResource CaptionTextBlockStyle}" />
        <TextBlock x:Name="StoreHealth" Text="Waiting for a sample" TextWrapping="Wrap" />
       </StackPanel>
      </Border>
     </Grid>
     <Grid ColumnSpacing="12">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Padding="16" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
       <StackPanel Spacing="6">
        <TextBlock Text="CPU" Style="{ThemeResource SubtitleTextBlockStyle}" />
        <TextBlock x:Name="CpuValue" Text="Unavailable" Style="{ThemeResource TitleTextBlockStyle}" AutomationProperties.Name="CPU current value" />
        <ProgressBar x:Name="CpuGauge" Minimum="0" Maximum="100" IsIndeterminate="True" AutomationProperties.Name="CPU utilization" />
        <TextBlock x:Name="CpuState" Text="Waiting for a sample" TextWrapping="Wrap" Opacity="0.72" />
       </StackPanel>
      </Border>
      <Border Grid.Column="1" Padding="16" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
       <StackPanel Spacing="6">
        <TextBlock Text="RAM" Style="{ThemeResource SubtitleTextBlockStyle}" />
        <TextBlock x:Name="RamValue" Text="Unavailable" Style="{ThemeResource TitleTextBlockStyle}" AutomationProperties.Name="RAM current value" />
        <ProgressBar x:Name="RamGauge" Minimum="0" Maximum="100" IsIndeterminate="True" AutomationProperties.Name="RAM utilization" />
        <TextBlock x:Name="RamState" Text="Waiting for a sample" TextWrapping="Wrap" Opacity="0.72" />
       </StackPanel>
      </Border>
      <Border Grid.Column="2" Padding="16" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
       <StackPanel Spacing="6">
        <TextBlock Text="GPU" Style="{ThemeResource SubtitleTextBlockStyle}" />
        <TextBlock x:Name="GpuValue" Text="Unavailable" Style="{ThemeResource TitleTextBlockStyle}" AutomationProperties.Name="GPU current value" />
        <ProgressBar x:Name="GpuGauge" Minimum="0" Maximum="100" IsIndeterminate="True" AutomationProperties.Name="GPU utilization" />
        <TextBlock x:Name="GpuState" Text="Waiting for a sample" TextWrapping="Wrap" Opacity="0.72" />
       </StackPanel>
      </Border>
      <Border Grid.Column="3" Padding="16" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
       <StackPanel Spacing="6">
        <TextBlock Text="Retained context" Style="{ThemeResource SubtitleTextBlockStyle}" />
        <TextBlock x:Name="ContextValue" Text="No selected run" Style="{ThemeResource TitleTextBlockStyle}" TextWrapping="Wrap" AutomationProperties.Name="Retained context value" />
        <ProgressBar x:Name="ContextGauge" Minimum="0" Maximum="100" IsIndeterminate="True" AutomationProperties.Name="Retained context capacity" />
        <TextBlock x:Name="ContextState" Text="Waiting for a run sample" TextWrapping="Wrap" Opacity="0.72" />
       </StackPanel>
      </Border>
     </Grid>
     <Border Padding="16" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
      <StackPanel Spacing="8">
       <TextBlock Text="Resource history" Style="{ThemeResource SubtitleTextBlockStyle}" />
       <TextBlock x:Name="HistoryEquivalentText" Text="No history samples" TextWrapping="Wrap" AutomationProperties.Name="Resource history values" />
       <Canvas x:Name="HistoryCanvas" Height="132" MinWidth="320" Background="{ThemeResource SubtleFillColorTransparentBrush}" AutomationProperties.Name="CPU and RAM history chart" SizeChanged="TelemetryChartSizeChanged">
        <Polyline x:Name="CpuHistoryLine" Stroke="{ThemeResource AccentFillColorDefaultBrush}" StrokeThickness="3" />
        <Polyline x:Name="RamHistoryLine" Stroke="{ThemeResource SystemFillColorSuccessBrush}" StrokeThickness="3" />
       </Canvas>
       <TextBlock Text="CPU (accent) · RAM (success) · 0–100 percent" Style="{ThemeResource CaptionTextBlockStyle}" />
       <TextBlock Text="Tool and provider latency" Style="{ThemeResource SubtitleTextBlockStyle}" Margin="0,8,0,0" />
       <TextBlock x:Name="LatencyEquivalentText" Text="No latency observations" TextWrapping="Wrap" AutomationProperties.Name="Activity latency values" />
       <Canvas x:Name="LatencyCanvas" Height="72" MinWidth="320" Background="{ThemeResource SubtleFillColorTransparentBrush}" AutomationProperties.Name="Recent activity latency chart" SizeChanged="TelemetryChartSizeChanged">
        <Polyline x:Name="LatencyHistoryLine" Stroke="{ThemeResource SystemFillColorCautionBrush}" StrokeThickness="3" />
       </Canvas>
      </StackPanel>
     </Border>
     <Border Padding="16" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
      <StackPanel Spacing="8">
       <TextBlock Text="Recent activity" Style="{ThemeResource SubtitleTextBlockStyle}" />
       <StackPanel x:Name="ActivityTimeline" Spacing="6" AutomationProperties.Name="Recent Manager activity timeline" />
      </StackPanel>
     </Border>
     <Border Padding="18" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
      <StackPanel Spacing="10">
       <TextBlock Text="Manager connection" Style="{ThemeResource SubtitleTextBlockStyle}" />
       <TextBlock x:Name="ManagerState" Text="Start the manager or refresh to read its current status." TextWrapping="Wrap" />
       <StackPanel Orientation="Horizontal" Spacing="12">
        <Button Content="Start manager" Click="StartClicked" />
        <Button Content="Stop service" Click="StopClicked" />
        <Button Content="Restart service" Click="RestartClicked" />
        <Button Content="Refresh" Click="RefreshClicked" />
       </StackPanel>
      </StackPanel>
     </Border>
    </StackPanel>

    <StackPanel x:Name="ProviderPanel" Spacing="14" Visibility="Collapsed">
     <InfoBar IsOpen="True" Severity="Informational" IsClosable="False"
       Title="Local provider" Message="Settings are stored by the Manager. Testing reads LM Studio /v1/models without starting a model response." />
     <Grid ColumnSpacing="16" RowSpacing="12">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
       <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
       <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <TextBox x:Name="ProviderHost" Header="Loopback host" PlaceholderText="127.0.0.1" />
      <NumberBox x:Name="ProviderPort" Grid.Column="1" Header="Port" Minimum="1" Maximum="65535" SpinButtonPlacementMode="Compact" />
      <TextBox x:Name="ProviderModel" Grid.Row="1" Grid.ColumnSpan="2" Header="Model" PlaceholderText="Automatic: first loaded model" />
      <ToggleSwitch x:Name="ProviderSecure" Grid.Row="2" Header="Use HTTPS" OffContent="HTTP" OnContent="HTTPS" />
      <NumberBox x:Name="ContextCapacity" Grid.Row="3" Header="Effective context capacity" Minimum="4096" Maximum="1048576" SpinButtonPlacementMode="Compact" />
      <NumberBox x:Name="ResponseReserve" Grid.Row="3" Grid.Column="1" Header="Next response reserve" Minimum="1" Maximum="1048575" SpinButtonPlacementMode="Compact" />
      <NumberBox x:Name="HandoffReserve" Grid.Row="4" Header="Handoff reserve" Minimum="1" Maximum="1048575" SpinButtonPlacementMode="Compact" />
      <NumberBox x:Name="SafetyMargin" Grid.Row="4" Grid.Column="1" Header="Estimation safety margin" Minimum="1" Maximum="1048575" SpinButtonPlacementMode="Compact" />
     </Grid>
     <TextBlock Text="Rollover begins only when observed context plus the next-response, handoff, and safety reserves reaches the effective capacity." TextWrapping="Wrap" Opacity="0.72" />
     <StackPanel Orientation="Horizontal" Spacing="12">
      <Button Content="Load saved settings" Click="ProviderLoadClicked" />
      <Button Content="Save" Click="ProviderSaveClicked" />
      <Button Content="Test connection" Click="ProviderTestClicked" />
     </StackPanel>
     <TextBlock x:Name="ProviderState" Text="Load saved settings to begin." TextWrapping="Wrap" />
    </StackPanel>

    <StackPanel x:Name="AutonomyPanel" Spacing="14" Visibility="Collapsed">
     <InfoBar IsOpen="True" Severity="Informational" IsClosable="False"
       Title="Manager-owned execution" Message="The Manager keeps running when this window closes. Reopen the app and use the run ID to attach again." />
     <Grid ColumnSpacing="16" RowSpacing="12">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <TextBox x:Name="RunProjectId" Header="Project ID" PlaceholderText="Project UUID" />
      <TextBox x:Name="RunClientId" Grid.Column="1" Header="Client ID" Text="forge-conductor-manager" />
      <NumberBox x:Name="RunAuthorityGeneration" Grid.Row="1" Header="Authority generation" Minimum="1" Maximum="4294967295" Value="1" SpinButtonPlacementMode="Compact" />
      <TextBox x:Name="RunId" Grid.Row="1" Grid.Column="1" Header="Run ID" PlaceholderText="Filled after Start; paste to reattach" />
      <TextBox x:Name="RunTask" Grid.Row="2" Grid.ColumnSpan="2" Header="Task" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="96" />
     </Grid>
     <StackPanel Orientation="Horizontal" Spacing="12">
      <Button Content="Start" Click="RunStartClicked" />
      <Button Content="Refresh" Click="RunStatusClicked" />
      <Button Content="Pause" Click="RunPauseClicked" />
      <Button Content="Resume" Click="RunResumeClicked" />
      <Button Content="Stop" Click="RunCancelClicked" />
     </StackPanel>
     <Border Padding="18" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
      <StackPanel Spacing="8">
       <TextBlock Text="Run and continuity state" Style="{ThemeResource SubtitleTextBlockStyle}" />
       <TextBlock x:Name="RunState" Text="Enter a project and task, or paste a run ID to attach." TextWrapping="Wrap" IsTextSelectionEnabled="True" />
      </StackPanel>
     </Border>
    </StackPanel>

    <StackPanel x:Name="ProjectsPanel" Spacing="14" Visibility="Collapsed">
     <InfoBar IsOpen="True" Severity="Informational" IsClosable="False"
       Title="Manager-owned project identity" Message="Registration binds an authorized folder to a stable project ID. Memory reads and writes always use the selected ID." />
     <Border Padding="18" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
      <StackPanel Spacing="10">
       <TextBlock Text="Register or select a project" Style="{ThemeResource SubtitleTextBlockStyle}" />
       <Grid ColumnSpacing="12" RowSpacing="10">
        <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBox x:Name="ProjectPath" Header="Authorized project folder" PlaceholderText="D:\Projects\Example" />
        <TextBox x:Name="ProjectDisplayName" Grid.Column="1" Header="Display name (optional)" />
        <ComboBox x:Name="ProjectSelector" Grid.Row="1" Grid.ColumnSpan="2" Header="Active project" HorizontalAlignment="Stretch" SelectionChanged="ProjectSelectionChanged" />
       </Grid>
       <StackPanel Orientation="Horizontal" Spacing="12">
        <Button Content="Register folder" Click="ProjectRegisterClicked" />
        <Button Content="Refresh projects" Click="ProjectRefreshClicked" />
       </StackPanel>
       <TextBlock x:Name="ProjectState" Text="Refresh to load registered projects." TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
       <TextBlock x:Name="ProjectIdentity" Text="No active project" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
       <TextBlock x:Name="ProjectFolders" Text="No authorized folders" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
       <TextBlock x:Name="ProjectPersistence" Text="Memory persistence has not been read." TextWrapping="Wrap" />
      </StackPanel>
     </Border>
     <Border Padding="18" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
      <StackPanel Spacing="10">
       <TextBlock Text="Search and read memory" Style="{ThemeResource SubtitleTextBlockStyle}" />
       <TextBox x:Name="ProjectMemoryQuery" Header="Search" PlaceholderText="Leave empty for recent memory" />
       <Button Content="Search memory" HorizontalAlignment="Left" Click="ProjectSearchClicked" />
       <StackPanel x:Name="ProjectMemoryRecords" Spacing="8" AutomationProperties.Name="Project memory results" />
      </StackPanel>
     </Border>
     <Border Padding="18" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
      <StackPanel Spacing="10">
       <TextBlock Text="Remember" Style="{ThemeResource SubtitleTextBlockStyle}" />
       <TextBox x:Name="ProjectMemoryTitle" Header="Title" />
       <TextBox x:Name="ProjectMemorySummary" Header="Summary" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" />
       <TextBox x:Name="ProjectMemoryBody" Header="Details (optional)" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="96" />
       <TextBox x:Name="ProjectMemoryTags" Header="Tags (comma separated)" />
       <Button Content="Save memory" HorizontalAlignment="Left" Click="ProjectRememberClicked" />
      </StackPanel>
     </Border>
    </StackPanel>

    <StackPanel x:Name="GenericPanel" Spacing="14" Visibility="Collapsed">
     <Border Padding="18" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
      <StackPanel Spacing="10">
       <TextBlock Text="Live Manager status" Style="{ThemeResource SubtitleTextBlockStyle}" />
       <TextBlock x:Name="GenericState" Text="Refresh to read the current Manager-owned state." TextWrapping="Wrap" />
       <Button Content="Refresh Manager state" HorizontalAlignment="Left" Click="RefreshClicked" />
      </StackPanel>
     </Border>
    </StackPanel>
   </StackPanel>
  </ScrollViewer>
 </NavigationView>
</Window>
