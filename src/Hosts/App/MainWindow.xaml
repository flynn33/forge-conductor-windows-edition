    <StackPanel x:Name="SettingsPanel" Spacing="14" Visibility="Collapsed">
     <Border Style="{ThemeResource ForgeHeroCardStyle}" MinHeight="118" Padding="20"><Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions><Border Width="52" Height="52" CornerRadius="12" Background="{ThemeResource ForgeAccentSoftBrush}"><FontIcon Glyph="&#xE713;" FontSize="24" Foreground="{ThemeResource ForgeAccentBrush}"/></Border><StackPanel Grid.Column="1" Spacing="5" VerticalAlignment="Center"><TextBlock Text="Effective configuration" FontFamily="Segoe UI Variable Display" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="The Manager owns these preferences. Save includes an effective readback." Style="{ThemeResource ForgeCaptionStyle}"/></StackPanel><StackPanel Grid.Column="2" Spacing="5" VerticalAlignment="Center"><TextBlock Text="SOURCE OF TRUTH" Style="{ThemeResource ForgeCaptionStyle}"/><TextBlock x:Name="SettingsHeroReadback" Text="Awaiting Manager settings" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/></StackPanel></Grid></Border>
     <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{ThemeResource ForgeCardStyle}" MinHeight="105"><StackPanel Spacing="7"><TextBlock Text="Dashboard" Style="{ThemeResource ForgeCaptionStyle}"/><TextBlock x:Name="SettingsDashboardSummary" Text="—" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="Local control endpoint" Style="{ThemeResource ForgeCaptionStyle}"/></StackPanel></Border><Border Grid.Column="1" Style="{ThemeResource ForgeCardStyle}" MinHeight="105"><StackPanel Spacing="7"><TextBlock Text="Model endpoint" Style="{ThemeResource ForgeCaptionStyle}"/><TextBlock x:Name="SettingsProviderSummary" Text="—" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="Loopback Responses" Style="{ThemeResource ForgeCaptionStyle}"/></StackPanel></Border><Border Grid.Column="2" Style="{ThemeResource ForgeCardStyle}" MinHeight="105"><StackPanel Spacing="7"><TextBlock Text="Context threshold" Style="{ThemeResource ForgeCaptionStyle}"/><TextBlock x:Name="SettingsContextSummary" Text="—" Style="{ThemeResource ForgeMetricValueStyle}" FontSize="27"/><TextBlock Text="Effective tokens" Style="{ThemeResource ForgeCaptionStyle}"/></StackPanel></Border><Border Grid.Column="3" Style="{ThemeResource ForgeCardStyle}" MinHeight="105"><StackPanel Spacing="7"><TextBlock Text="Shell policy" Style="{ThemeResource ForgeCaptionStyle}"/><TextBlock x:Name="SettingsShellSummary" Text="—" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Manager invocation guard" Style="{ThemeResource ForgeCaptionStyle}"/></StackPanel></Border></Grid>
     <Border Style="{ThemeResource ForgeCardStyle}"><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Spacing="5"><TextBlock Text="Apply &amp; verify" Style="{ThemeResource ForgeSectionTitleStyle}"/><TextBlock Text="Unsaved edits remain pending until the Manager accepts and reads them back." Style="{ThemeResource ForgeCaptionStyle}"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><Button Content="Reload" Click="SettingsLoadClicked"/><Button Content="Revert" Click="SettingsRevertClicked"/><Button Content="Save &amp; read back" Click="SettingsSaveClicked" Style="{ThemeResource ForgeAccentButtonStyle}"/></StackPanel></Grid></Border>
     <Expander Header="Manager &amp; dashboard controls" IsExpanded="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"><Border Style="{ThemeResource ForgeCardStyle}" HorizontalAlignment="Stretch"><StackPanel Spacing="14" HorizontalAlignment="Stretch">
     <Grid ColumnSpacing="16" RowSpacing="12">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <TextBox x:Name="SettingsDashboardHost" Header="Dashboard loopback host" AutomationProperties.Name="Dashboard loopback host" />
      <NumberBox x:Name="SettingsDashboardPort" Grid.Column="1" Header="Dashboard port" Minimum="1" Maximum="65535" SpinButtonPlacementMode="Compact" AutomationProperties.Name="Dashboard port" />
      <NumberBox x:Name="SettingsRefreshSeconds" Grid.Row="1" Header="Telemetry refresh interval (seconds)" Minimum="1" Maximum="3600" SpinButtonPlacementMode="Compact" AutomationProperties.Name="Telemetry refresh interval in seconds" />
      <NumberBox x:Name="SettingsWatchdogSeconds" Grid.Row="1" Grid.Column="1" Header="Manager watchdog interval (seconds)" Minimum="1" Maximum="3600" SpinButtonPlacementMode="Compact" AutomationProperties.Name="Manager watchdog interval in seconds" />
      <ToggleSwitch x:Name="SettingsAutoRestart" Grid.Row="2" Header="Restart Manager after an unexpected exit" OffContent="Disabled" OnContent="Enabled" />
      <ToggleSwitch x:Name="SettingsOpenBrowser" Grid.Row="2" Grid.Column="1" Header="Open dashboard when Manager starts" OffContent="Disabled" OnContent="Enabled" />
      <NumberBox x:Name="SettingsSessionTtl" Grid.Row="3" Header="Inactive session retention (seconds)" Minimum="60" Maximum="31536000" SpinButtonPlacementMode="Compact" AutomationProperties.Name="Inactive session retention in seconds" />
      <NumberBox x:Name="SettingsShellTimeout" Grid.Row="3" Grid.Column="1" Header="Shell timeout (seconds)" Minimum="1" Maximum="3600" SpinButtonPlacementMode="Compact" AutomationProperties.Name="Shell timeout in seconds" />
     </Grid>
     <ToggleSwitch x:Name="SettingsShellEnabled" Header="Allow shell-backed tools" OffContent="Disabled" OnContent="Enabled" />
     <ComboBox x:Name="SettingsLogLevel" Header="Log detail" Width="260" HorizontalAlignment="Left" AutomationProperties.Name="Log detail">
      <ComboBoxItem Content="Trace"/><ComboBoxItem Content="Debug"/><ComboBoxItem Content="Information"/>
      <ComboBoxItem Content="Warning"/><ComboBoxItem Content="Error"/><ComboBoxItem Content="Critical"/>
     </ComboBox>
     </StackPanel></Border></Expander>
     <Expander Header="LM Studio provider controls" IsExpanded="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"><Border Style="{ThemeResource ForgeCardStyle}" HorizontalAlignment="Stretch"><StackPanel Spacing="14" HorizontalAlignment="Stretch">
     <Grid ColumnSpacing="16" RowSpacing="12">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <TextBox x:Name="SettingsProviderHost" Header="Loopback host" AutomationProperties.Name="LM Studio loopback host" />
      <NumberBox x:Name="SettingsProviderPort" Grid.Column="1" Header="Port" Minimum="1" Maximum="65535" SpinButtonPlacementMode="Compact" AutomationProperties.Name="LM Studio port" />
      <TextBox x:Name="SettingsProviderModel" Grid.Row="1" Grid.ColumnSpan="2" Header="Loaded model name" PlaceholderText="Leave blank to select the first loaded model automatically" />
      <ToggleSwitch x:Name="SettingsProviderSecure" Grid.Row="2" Header="Use HTTPS" OffContent="HTTP" OnContent="HTTPS" />
     </Grid>
     <TextBlock Text="LM Studio is a loopback provider and does not require a stored credential. Test connection discovers the currently loaded model without starting a response." TextWrapping="Wrap" Opacity="0.72" />
     </StackPanel></Border></Expander>
     <Expander Header="Context rollover policy" IsExpanded="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"><Border Style="{ThemeResource ForgeCardStyle}" HorizontalAlignment="Stretch"><StackPanel Spacing="14" HorizontalAlignment="Stretch">
     <TextBlock Text="The effective capacity is Forge Conductor's operating threshold. It may be lower than the model's loaded capacity. Rollover begins when observed context plus all three reserves reaches this threshold." TextWrapping="Wrap" Opacity="0.72" />
     <Grid ColumnSpacing="16" RowSpacing="12">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Slider x:Name="SettingsContextCapacitySlider" Header="Effective context capacity" Minimum="4096" Maximum="1048576" StepFrequency="1024" Value="{Binding Value, ElementName=SettingsContextCapacity, Mode=TwoWay}" AutomationProperties.Name="Effective context capacity slider" />
      <NumberBox x:Name="SettingsContextCapacity" Grid.Column="1" Header="Exact tokens" Minimum="4096" Maximum="1048576" SpinButtonPlacementMode="Compact" AutomationProperties.Name="Exact effective context capacity in tokens" />
      <Slider x:Name="SettingsResponseReserveSlider" Grid.Row="1" Header="Next response reserve" Minimum="1" Maximum="65536" StepFrequency="256" Value="{Binding Value, ElementName=SettingsResponseReserve, Mode=TwoWay}" AutomationProperties.Name="Next response reserve slider" />
      <NumberBox x:Name="SettingsResponseReserve" Grid.Row="1" Grid.Column="1" Header="Exact tokens" Minimum="1" Maximum="1048575" SpinButtonPlacementMode="Compact" AutomationProperties.Name="Exact next response reserve in tokens" />
      <Slider x:Name="SettingsHandoffReserveSlider" Grid.Row="2" Header="Handoff reserve" Minimum="1" Maximum="65536" StepFrequency="256" Value="{Binding Value, ElementName=SettingsHandoffReserve, Mode=TwoWay}" AutomationProperties.Name="Handoff reserve slider" />
      <NumberBox x:Name="SettingsHandoffReserve" Grid.Row="2" Grid.Column="1" Header="Exact tokens" Minimum="1" Maximum="1048575" SpinButtonPlacementMode="Compact" AutomationProperties.Name="Exact handoff reserve in tokens" />
      <Slider x:Name="SettingsSafetyMarginSlider" Grid.Row="3" Header="Estimation safety margin" Minimum="1" Maximum="65536" StepFrequency="256" Value="{Binding Value, ElementName=SettingsSafetyMargin, Mode=TwoWay}" AutomationProperties.Name="Estimation safety margin slider" />
      <NumberBox x:Name="SettingsSafetyMargin" Grid.Row="3" Grid.Column="1" Header="Exact tokens" Minimum="1" Maximum="1048575" SpinButtonPlacementMode="Compact" AutomationProperties.Name="Exact estimation safety margin in tokens" />
     </Grid>
     </StackPanel></Border></Expander>
     <Expander Header="Data maintenance · destructive actions" IsExpanded="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"><Border Style="{ThemeResource ForgeCardStyle}" HorizontalAlignment="Stretch"><StackPanel Spacing="14" HorizontalAlignment="Stretch">
     <InfoBar IsOpen="True" Severity="Warning" IsClosable="False" Title="Exact confirmation required"
      Message="Project resets affect only the exact selected project ID. All-project reset affects every registered project in this profile. Source folders are never deleted." />
     <ComboBox x:Name="MaintenanceScope" Header="Reset scope" Width="360" HorizontalAlignment="Left" SelectedIndex="0" AutomationProperties.Name="Data reset scope">
      <ComboBoxItem Content="Selected project memory"/>
      <ComboBoxItem Content="Selected project continuity"/>
      <ComboBoxItem Content="Selected project memory and continuity"/>
      <ComboBoxItem Content="All registered project data"/>
     </ComboBox>
     <TextBox x:Name="MaintenanceConfirmation" Header="Type the exact confirmation shown below" AutomationProperties.Name="Exact reset confirmation" />
     <Button Content="Run confirmed reset" HorizontalAlignment="Left" Click="MaintenanceResetClicked" />
     <TextBlock x:Name="MaintenanceState" Text="Select a project on the Projects page, then return here to see the exact confirmation." TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" IsTextSelectionEnabled="True" />
     </StackPanel></Border></Expander>
     <Border Style="{ThemeResource ForgeCardStyle}"><StackPanel Spacing="12">
     <TextBlock Text="Apply and verify" Style="{ThemeResource ForgeSectionTitleStyle}"/>
     <StackPanel Orientation="Horizontal" Spacing="10">
      <Button Content="Load effective settings" Click="SettingsLoadClicked" />
      <Button Content="Save and read back" Click="SettingsSaveClicked" Style="{ThemeResource ForgeAccentButtonStyle}" />
      <Button Content="Revert pending edits" Click="SettingsRevertClicked" />
      <Button Content="Test LM Studio" Click="SettingsTestClicked" />
      <Button Content="Restart Manager" Click="SettingsRestartClicked" />
     </StackPanel>
     <StackPanel Orientation="Horizontal" Spacing="12">
      <Button Content="Open focused Provider controls" Click="OpenProviderClicked" />
      <Button Content="Open Manager status and controls" Click="OpenManagerClicked" />
     </StackPanel>
     <TextBlock x:Name="SettingsState" Text="Load effective settings to begin." TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" IsTextSelectionEnabled="True" />
     </StackPanel></Border>
    </StackPanel>

    <StackPanel x:Name="GenericPanel" Spacing="14" Visibility="Collapsed">
     <Border Style="{ThemeResource ForgeCardStyle}">
      <StackPanel Spacing="10">
       <TextBlock Text="Live Manager status" Style="{ThemeResource SubtitleTextBlockStyle}" />
       <TextBlock x:Name="GenericState" Text="Refresh to read the current Manager-owned state." TextWrapping="Wrap" />
       <Button Content="Refresh Manager state" HorizontalAlignment="Left" Click="RefreshClicked" />
      </StackPanel>
     </Border>
    </StackPanel>
   </StackPanel>
  </ScrollViewer>
 </NavigationView>
</Window>
