<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package
      Name="Forge Conductor"
      Manufacturer="Jim Daley"
      Version="0.8.0"
      UpgradeCode="A81B2C3D-1001-4A01-8001-000000000040"
      Scope="perMachine">
    <MajorUpgrade DowngradeErrorMessage="A newer version of Forge Conductor is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <Icon Id="AppIcon" SourceFile="..\..\resources\Icons\ForgeConductor.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/flynn33/Forge-Conductor-MacOS" />
    <Feature Id="ProductFeature" Title="Forge Conductor" Level="1">
      <ComponentGroupRef Id="ProductComponents" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>
    <ui:WixUI Id="WixUI_Minimal" />
  </Package>

  <Fragment>
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="ForgeConductor">
        <Directory Id="AgentsFolder" Name="Agents" />
        <Directory Id="ManifestsFolder" Name="ForsettiManifests" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AppMenuFolder" Name="Forge Conductor" />
    </StandardDirectory>
  </Fragment>

  <Fragment>
    <ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">
      <Component Id="AppExe" Guid="A81B2C3D-1001-4A01-8001-000000000041">
        <File Id="ForgeConductorExe" Source="..\..\out\Release\x64\ForgeConductorApp\ForgeConductor.exe" KeyPath="yes" />
      </Component>
      <Component Id="AgentExplore" Directory="AgentsFolder" Guid="A81B2C3D-1001-4A01-8001-000000000050"><File Source="..\..\resources\Agents\explore.md" /></Component>
      <Component Id="AgentPlan" Directory="AgentsFolder" Guid="A81B2C3D-1001-4A01-8001-000000000051"><File Source="..\..\resources\Agents\plan.md" /></Component>
      <Component Id="AgentImplement" Directory="AgentsFolder" Guid="A81B2C3D-1001-4A01-8001-000000000052"><File Source="..\..\resources\Agents\implement.md" /></Component>
      <Component Id="AgentDebug" Directory="AgentsFolder" Guid="A81B2C3D-1001-4A01-8001-000000000053"><File Source="..\..\resources\Agents\debug.md" /></Component>
      <Component Id="AgentTest" Directory="AgentsFolder" Guid="A81B2C3D-1001-4A01-8001-000000000054"><File Source="..\..\resources\Agents\test.md" /></Component>
      <Component Id="AgentReview" Directory="AgentsFolder" Guid="A81B2C3D-1001-4A01-8001-000000000055"><File Source="..\..\resources\Agents\review.md" /></Component>
      <Component Id="AgentSecurity" Directory="AgentsFolder" Guid="A81B2C3D-1001-4A01-8001-000000000056"><File Source="..\..\resources\Agents\security.md" /></Component>
      <Component Id="AgentDocs" Directory="AgentsFolder" Guid="A81B2C3D-1001-4A01-8001-000000000057"><File Source="..\..\resources\Agents\docs.md" /></Component>
      <Component Id="AgentPrecommit" Directory="AgentsFolder" Guid="A81B2C3D-1001-4A01-8001-000000000058"><File Source="..\..\resources\Agents\precommit-audit.md" /></Component>
      <Component Id="AgentResearch" Directory="AgentsFolder" Guid="A81B2C3D-1001-4A01-8001-000000000059"><File Source="..\..\resources\Agents\research.md" /></Component>
      <Component Id="ManPersist" Directory="ManifestsFolder" Guid="A81B2C3D-1001-4A01-8001-000000000060"><File Source="..\..\resources\Manifests\PersistenceModule.json" /></Component>
      <Component Id="ManOrch" Directory="ManifestsFolder" Guid="A81B2C3D-1001-4A01-8001-000000000061"><File Source="..\..\resources\Manifests\OrchestrationModule.json" /></Component>
      <Component Id="ManMcp" Directory="ManifestsFolder" Guid="A81B2C3D-1001-4A01-8001-000000000062"><File Source="..\..\resources\Manifests\McpModule.json" /></Component>
      <Component Id="ManTel" Directory="ManifestsFolder" Guid="A81B2C3D-1001-4A01-8001-000000000063"><File Source="..\..\resources\Manifests\TelemetryModule.json" /></Component>
      <Component Id="ManLm" Directory="ManifestsFolder" Guid="A81B2C3D-1001-4A01-8001-000000000064"><File Source="..\..\resources\Manifests\LmStudioModule.json" /></Component>
      <Component Id="ManMgr" Directory="ManifestsFolder" Guid="A81B2C3D-1001-4A01-8001-000000000065"><File Source="..\..\resources\Manifests\ManagerModule.json" /></Component>
      <Component Id="ManOp" Directory="ManifestsFolder" Guid="A81B2C3D-1001-4A01-8001-000000000066"><File Source="..\..\resources\Manifests\OperatorAppModule.json" /></Component>
      <Component Id="ManComfy" Directory="ManifestsFolder" Guid="A81B2C3D-1001-4A01-8001-000000000067"><File Source="..\..\resources\Manifests\ComfyModule.json" /></Component>
    </ComponentGroup>
    <Component Id="StartMenuShortcut" Directory="AppMenuFolder" Guid="A81B2C3D-1001-4A01-8001-000000000042">
      <Shortcut
          Id="AppShortcut"
          Name="Forge Conductor"
          Description="Forge Conductor operator dashboard"
          Target="[INSTALLFOLDER]ForgeConductor.exe"
          WorkingDirectory="INSTALLFOLDER"
          Icon="AppIcon" />
      <RemoveFolder Id="RemoveAppMenu" On="uninstall" />
      <RegistryValue Root="HKCU" Key="Software\ForgeConductor" Name="installed" Type="integer" Value="1" KeyPath="yes" />
    </Component>
  </Fragment>
</Wix>
