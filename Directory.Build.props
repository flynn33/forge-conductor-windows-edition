<Project>
  <PropertyGroup>
    <ForgeRoot>$(MSBuildThisFileDirectory)</ForgeRoot>
    <CharacterSet>Unicode</CharacterSet>
    <PlatformToolset Condition="'$(PlatformToolset)' == ''">v143</PlatformToolset>
    <WindowsTargetPlatformVersion Condition="'$(WindowsTargetPlatformVersion)' == ''">10.0.26100.0</WindowsTargetPlatformVersion>
    <PreferredToolArchitecture>x64</PreferredToolArchitecture>
    <VcpkgEnabled>false</VcpkgEnabled>
    <WindowsPackageType>None</WindowsPackageType>
    <AppxPackage>false</AppxPackage>
    <UseCommonOutputDirectory>false</UseCommonOutputDirectory>
    <OutDir>$(ForgeRoot)out\$(Configuration)\$(Platform)\$(MSBuildProjectName)\</OutDir>
    <IntDir>$(ForgeRoot)out\obj\$(Configuration)\$(Platform)\$(MSBuildProjectName)\</IntDir>
  </PropertyGroup>

  <PropertyGroup>
    <ForgeIncludeRoots>
      $(ForgeRoot)src\ForgeRuntime\include;
      $(ForgeRoot)src\ForgePlatform\include;
      $(ForgeRoot)src\ForgeHost\include;
      $(ForgeRoot)src\ForgeDomain\include;
      $(ForgeRoot)src\ForgePersistence\include;
      $(ForgeRoot)src\ForgeOrchestration\include;
      $(ForgeRoot)src\ForgeMcp\include;
      $(ForgeRoot)src\ForgeTelemetry\include;
      $(ForgeRoot)src\ForgeLmStudio\include;
      $(ForgeRoot)src\ForgeComfy\include;
      $(ForgeRoot)src\ForgeManager\include;
      $(ForgeRoot)src\ForgeGaugeKit\include;
      $(ForgeRoot)src\ForgeUi\include;
      $(ForgeRoot)third_party
    </ForgeIncludeRoots>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <ClCompile>
      <LanguageStandard>stdcpp20</LanguageStandard>
      <ConformanceMode>true</ConformanceMode>
      <WarningLevel>Level4</WarningLevel>
      <TreatWarningAsError>true</TreatWarningAsError>
      <SDLCheck>true</SDLCheck>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
      <ExceptionHandling>Sync</ExceptionHandling>
      <RuntimeTypeInfo>true</RuntimeTypeInfo>
      <ExternalWarningLevel>TurnOffAllWarnings</ExternalWarningLevel>
      <AdditionalOptions>/utf-8 /permissive- /external:I "$(ForgeRoot)third_party" /external:W0 %(AdditionalOptions)</AdditionalOptions>
      <PreprocessorDefinitions>UNICODE;_UNICODE;NOMINMAX;WIN32_LEAN_AND_MEAN;_CRT_SECURE_NO_WARNINGS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalIncludeDirectories>$(ForgeIncludeRoots);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <RuntimeLibrary Condition="'$(Configuration)'=='Debug'">MultiThreadedDebugDLL</RuntimeLibrary>
      <RuntimeLibrary Condition="'$(Configuration)'=='Release'">MultiThreadedDLL</RuntimeLibrary>
    </ClCompile>
    <Link>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <AdditionalDependencies>winsqlite3.lib;pdh.lib;dxgi.lib;d3d11.lib;d3dcompiler.lib;dxguid.lib;windowscodecs.lib;shlwapi.lib;shell32.lib;ole32.lib;advapi32.lib;user32.lib;gdi32.lib;taskschd.lib;runtimeobject.lib;winhttp.lib;bcrypt.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
</Project>
