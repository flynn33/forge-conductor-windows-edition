{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "microtasks"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "microtasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "phase_id",
          "role",
          "title",
          "objective",
          "dependencies",
          "document_routes",
          "rag_queries",
          "required_capabilities",
          "allowed_write_roots",
          "max_files_changed",
          "max_lines_changed",
          "max_tool_calls",
          "max_attempts",
          "acceptance",
          "status",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "phase_id": {
            "type": "string",
            "pattern": "^P\\d{2}$"
          },
          "role": {
            "enum": [
              "architect",
              "builder",
              "validator",
              "documentation_manager",
              "release_manager"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "objective": {
            "type": "string",
            "minLength": 1
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "document_routes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "rag_queries": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "required_capabilities": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "shell",
                "filesystem",
                "github",
                "rag_v1",
                "js_sandbox",
                "long_term_memory",
                "persistent_memory"
              ]
            }
          },
          "allowed_write_roots": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "max_files_changed": {
            "type": "integer",
            "minimum": 0
          },
          "max_lines_changed": {
            "type": "integer",
            "minimum": 0
          },
          "max_tool_calls": {
            "type": "integer",
            "minimum": 1,
            "maximum": 30
          },
          "max_attempts": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "acceptance": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "status": {
            "enum": [
              "not_started",
              "in_progress",
              "passed",
              "blocked",
              "failed"
            ]
          },
          "evidence": {
            "type": "array"
          },
          "attempts": {
            "type": "integer",
            "minimum": 0
          },
          "last_message": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "microtask_count": {
      "type": "integer",
      "minimum": 1
    },
    "selection_rule": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}
