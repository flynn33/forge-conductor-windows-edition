{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build-debug",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/build.ps1",
      "args": ["-Configuration", "Debug"],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "test",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/test.ps1",
      "group": "test"
    }
  ]
}
